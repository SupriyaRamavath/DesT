{
  "info": {
    "_postman_id": "8d1b3c44-8f2c-4a09-a8b0-decisiontrace",
    "name": "DesT API",
    "description": "Requests for currently registered DesT Express routes. Requests labeled NOT IMPLEMENTED are intentionally excluded; see TESTING_PLAN.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "authToken", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "decisionId", "value": "" },
    { "key": "email", "value": "qa+decisiontrace@example.test" },
    { "key": "password", "value": "CorrectHorseBattery9!" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/health" }
        },
        {
          "name": "Root welcome",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('authToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Developer\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"developer\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('authToken', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Create application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('applicationId', pm.response.json().data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Eligibility Model\",\n  \"description\": \"Disposable test application\",\n  \"environment\": \"development\"\n}"
            },
            "url": "{{baseUrl}}/api/applications"
          }
        },
        {
          "name": "List applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/applications"
          }
        },
        {
          "name": "Update application",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Eligibility Model Updated\",\n  \"description\": \"Updated disposable test application\",\n  \"environment\": \"staging\"\n}"
            },
            "url": "{{baseUrl}}/api/applications/{{applicationId}}"
          }
        },
        {
          "name": "Delete application (cleanup)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}"
          }
        }
      ]
    },
    {
      "name": "Decisions",
      "item": [
        {
          "name": "Ingest decision",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('decisionId', pm.response.json().data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{applicationId}}\",\n  \"externalDecisionId\": \"qa-unique-001\",\n  \"input\": { \"income\": 72000, \"country\": \"US\" },\n  \"output\": { \"decision\": \"approved\" },\n  \"status\": \"completed\",\n  \"confidence\": 0.92,\n  \"riskLevel\": \"low\",\n  \"riskFlags\": [],\n  \"model\": { \"provider\": \"TestProvider\", \"name\": \"eligibility\", \"version\": \"1.0.0\" },\n  \"startedAt\": \"2026-09-25T10:00:00.000Z\",\n  \"completedAt\": \"2026-09-25T10:00:01.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/decisions/ingest"
          }
        },
        {
          "name": "List decisions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/decisions"
          }
        },
        {
          "name": "Decision detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": "{{baseUrl}}/api/decisions/{{decisionId}}"
          }
        }
      ]
    }
  ]
}
